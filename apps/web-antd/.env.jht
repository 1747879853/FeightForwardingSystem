# 津海通（jht）生产打包环境，使用方式：pnpm build:jht
VITE_APP_BRAND=jht
VITE_APP_TITLE=津海通
VITE_APP_NAMESPACE=vben-web-antd-jht

VITE_BASE=/
# 津海通生产接口（与浩瀚远洋环境隔离）
VITE_GLOB_API_URL=https://api.jinhaitone.com/api

VITE_COMPRESS=none
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=false
