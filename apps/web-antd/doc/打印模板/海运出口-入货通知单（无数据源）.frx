      <ShapeObject Name="ShapeWelcome" Left="33.6" Top="623.4" Width="308" Height="26.3" Fill.Color="235, 235, 235" Shape="RoundRectangle" Curve="0.8"/>
      <TextObject Name="TxtWelcome" Left="33.6" Top="623.4" Width="308" Height="26.3" Text="欢迎您选择瑞尔，我们将竭诚为您服务！" HorzAlign="Center" VertAlign="Center" Font="微软雅黑, 11pt, style=Bold"/>
      <TextObject Name="TxtNote1" Left="36.8" Top="651.8" Width="722" Height="19" Text="一、请在货物进港前提供准确重尺并要求回箱单务必填写准确。" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtNote2Line1" Left="36.8" Top="670.7" Width="722" Height="19" Text="二、为保证贵公司的货物安全，请在装箱之前安排业务人员对空箱进行检查，确认装箱是否有破损、水滴、异味、污渍等情况，如集" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtNote2Line2" Left="36.8" Top="689.6" Width="722" Height="19" Text="装箱有任何可能对贵司货物不利之影响，请及时与我司业务人员联系。" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTipsTitle" Left="36.8" Top="714.9" Width="400" Height="21" Text="温馨提示（操作中提醒注意如下问题）：" VertAlign="Center" Font="微软雅黑, 11pt, style=Bold"/>
      <TextObject Name="TxtTip1Title" Left="36.8" Top="738" Width="200" Height="20" Text="1.回箱情况：" VertAlign="Center" Font="微软雅黑, 10.5pt, style=Bold"/>
      <TextObject Name="TxtTip1Line1" Left="36.8" Top="761.1" Width="722" Height="19" Text="入货站装箱回货之前，务必提供准确的数量，如需分票，则提供每票资料，以避免出现未装完封箱集港的情况；外点回箱之前，必须" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTip1Line2" Left="36.8" Top="780" Width="722" Height="19" Text="提供准确的数量及分票情况，回箱单上要填写完整且如分票应该详细显示每票数量；整箱散卡送货到场站做站装货物考虑到现场的装" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTip1Line3" Left="36.8" Top="798.9" Width="722" Height="19" Text="箱时间，因此请务必提前 2-3 小时入货（特种箱根据情况而定），到站后如果办好手续没有立即装箱，请及时联系我司。" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTip2Title" Left="36.8" Top="823.1" Width="200" Height="20" Text="2.报关情况：" VertAlign="Center" Font="微软雅黑, 10.5pt, style=Bold"/>
      <TextObject Name="TxtTip2Line1" Left="36.8" Top="846.3" Width="722" Height="19" Text="需要我司通关请及时提供全套全部单据，自行安排报关请及时通关并告知我司，如分票通关请在入货前提供准确分票信息，如因未提" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTip2Line2" Left="36.8" Top="865.2" Width="722" Height="19" Text="供分票信息或者中间数量更改等原因而影响集港和通关导致甩货，责任自负。" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
      <TextObject Name="TxtTip3Title" Left="36.8" Top="889.4" Width="200" Height="20" Text="3.拖车：" VertAlign="Center" Font="微软雅黑, 10.5pt, style=Bold"/>
      <TextObject Name="TxtTip3Line1" Left="36.8" Top="912.5" Width="722" Height="19" Text="如需我司安排陆路运输，请务必在航期前 3-5 个工作日通知并告知准确拖车时间和拖货地点。" VertAlign="Center" WordWrap="false" Font="宋体, 9.2pt"/>
