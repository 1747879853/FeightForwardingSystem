# 佳越测试（jytest，:88）独立环境，使用方式：pnpm dev:jytest / pnpm build:jytest
# 品牌素材复用佳越软件，勿与 :85 佳越标准库、:86 演示环境混淆
VITE_APP_BRAND=jiayue
VITE_APP_TITLE=佳越测试
VITE_APP_NAMESPACE=vben-web-antd-jytest

VITE_PORT=5010
VITE_BASE=/
# 佳越测试后端地址（:88）
VITE_GLOB_API_URL=http://43.138.14.122:88/api
VITE_GLOB_STATIC_URL=http://43.138.14.122:88

VITE_DEVTOOLS=true
VITE_COMPRESS=none
VITE_PWA=false
VITE_ROUTER_HISTORY=hash
VITE_INJECT_APP_LOADING=true
VITE_ARCHIVER=false
