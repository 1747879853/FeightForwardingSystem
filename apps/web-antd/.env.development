# 端口号（pnpm dev / dev:antd，未指定客户品牌时使用佳越软件 + Vben 中性 Logo）
VITE_PORT=5010
VITE_APP_BRAND=jiayue
VITE_APP_TITLE=佳越软件
VITE_APP_NAMESPACE=vben-web-antd-jiayue
VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
