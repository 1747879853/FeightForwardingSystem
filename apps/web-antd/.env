# 应用标题
VITE_APP_TITLE=浩瀚远洋

# 应用命名空间（各品牌见 .env.development / .env.hhyy / .env.jht 等，用于缓存与 Store 隔离）
VITE_APP_NAMESPACE=vben-web-antd

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 货物轨迹地图（trackingeyes）内嵌地址与企业编号；仅传订阅号(mblNo)，其余不对外暴露
# 注意：地址含 # 锚点，必须用引号包裹，否则 dotenv 会把 #/Map 当注释丢弃
VITE_GLOB_TRACKING_MAP_URL="https://saas.trackingeyes.com/#/Map"
VITE_GLOB_TRACKING_COMPANY_ID=100514

# 船舶 AIS 定位 Iframe（地址含 # 锚点，必须用引号包裹）
VITE_GLOB_FREIGHTOWER_AIS_URL="https://i.saas.freightower.com/#/ais/vessel"
VITE_GLOB_FREIGHTOWER_AIS_CLIENT_ID=fdd5679abcb897963
VITE_GLOB_FREIGHTOWER_AIS_KEY=aUZyYW1lX9yRlvAQgZaJAEoBlP9NuT6zt8GCv6wSqLiBCi6EnRUv_IZ2CFUr2Udtj9RY-uOTaQ

# 空运运踪可视化 Iframe（海运轨迹页链接由后端下发，空运由前端拼装；地址含 # 锚点须加引号）
# 参数：key(可视化密钥) / clientId(客户账号) / businessNumber(航司单号) / showInfo(0隐藏 1展开 2收起) / lang
# 三项缺任一项时界面自动隐藏「查看轨迹地图」入口；取 token 的 secret 属服务端凭据，禁止放入前端 env
VITE_GLOB_FREIGHTOWER_AIR_TRACKING_URL="https://i.saas.freightower.com/#/air"
VITE_GLOB_FREIGHTOWER_AIR_TRACKING_CLIENT_ID=a5cfbbb978bab6c99
VITE_GLOB_FREIGHTOWER_AIR_TRACKING_KEY=SWZSQW1FX0vqymz1j5VnD8kDjirjOGSBLt5fXHglQ7_Wkvm6YwxlB-_E5wTh-QToE_SGmRsMPQ
