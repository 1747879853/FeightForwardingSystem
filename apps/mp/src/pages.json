{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^search-drawer$": "@/components/search-drawer/search-drawer.vue",
      "^skew-tabs$": "@/components/skew-tabs/skew-tabs.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/loading/list",
      "style": {
        "enablePullDownRefresh": true,
        "navigationStyle": "custom",
        "usingComponents": {
          "search-drawer": "/components/search-drawer/search-drawer",
          "skew-tabs": "/components/skew-tabs/skew-tabs"
        }
      }
    },
    {
      "path": "pages/points/index",
      "style": {
        "navigationBarTitleText": "积分兑换"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/loading/detail",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "globalStyle": {
    "backgroundColor": "#ECEEF6",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "监装师傅端"
  },
  "tabBar": {
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "color": "#6E7B83",
    "selectedColor": "#327AFF",
    "list": [
      {
        "iconPath": "static/icons/tab-home.png",
        "pagePath": "pages/home/index",
        "selectedIconPath": "static/icons/tab-home-active.png",
        "text": "首页"
      },
      {
        "iconPath": "static/icons/tab-work.png",
        "pagePath": "pages/loading/list",
        "selectedIconPath": "static/icons/tab-work-active.png",
        "text": "监装"
      },
      {
        "iconPath": "static/icons/tab-points.png",
        "pagePath": "pages/points/index",
        "selectedIconPath": "static/icons/tab-points-active.png",
        "text": "积分兑换"
      },
      {
        "iconPath": "static/icons/tab-profile.png",
        "pagePath": "pages/profile/index",
        "selectedIconPath": "static/icons/tab-profile-active.png",
        "text": "个人中心"
      }
    ]
  }
}
