# 后端根地址（不带 /api）。微信开发者工具需勾选「不校验合法域名」
# 津海通 (jht)，与 web-antd `.env.jht` 同源
VITE_API_ORIGIN=https://api.jinhaitone.com

# 是否放开开发态账密登录入口（正式包必须为 false）
VITE_ENABLE_PASSWORD_LOGIN=true

